# Application Configuration
APP_NAME="Honeytoken-Based Insider Threat Detector"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (SQLite default for zero-config local dev; use postgresql://... in production)
DATABASE_URL="sqlite:///./honeytoken.db"

# Beacon Telemetry Service
BEACON_BASE_URL="http://127.0.0.1:8000"

# Security & CORS
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
